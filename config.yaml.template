# === excel-master 配置模板 ===
# 复制为 config.yaml，将 YOUR_DEEPSEEK_API_KEY 替换为实际 key。
# 其余使用 Hermes 默认值，不需要改动。

model:
  base_url: https://api.deepseek.com/v1
  default: deepseek-v4-flash
  provider: deepseek

# 在下面填入你的 API key
# deepseek:
#   api_key: YOUR_DEEPSEEK_API_KEY

agent:
  max_turns: 150

terminal:
  backend: local
  persistent_shell: true

checkpoints:
  enabled: false
